# ===== Z.E.R.O backend configuration =====
# Copy this file to backend/.env and fill in the keys you have. Every
# integration degrades gracefully when its key is absent.

# --- Server ---
HOST=127.0.0.1
PORT=8000
DEBUG=true

# --- AI brain (required for full reasoning) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048

# --- Storage ---
# ZERO_DATA_DIR=/absolute/path/to/data   # defaults to backend/data

# --- Voice ---
VOICE_ENABLED=false
WAKE_WORD=zero
WHISPER_MODEL=base            # tiny | base | small | medium | large
TTS_ENGINE=pyttsx3            # pyttsx3 (offline) | elevenlabs (premium)

# --- Daily briefing ---
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# --- Integrations ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=San Francisco
GITHUB_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=
GOOGLE_CREDENTIALS_FILE=
NOTION_API_KEY=
SLACK_TOKEN=
